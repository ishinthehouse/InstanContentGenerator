# Server-side AI keys for the HOSTED generation endpoint (api/generate.js).
# Set these in the Vercel project's Environment Variables (NOT committed).
# Configure at least one provider. The hosted service uses the requested
# provider if its key is set, otherwise DEFAULT_AI_PROVIDER, otherwise any key.

CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=        # alias also accepted for Claude
OPENAI_API_KEY=
GEMINI_API_KEY=

# Which provider the hosted service prefers when the client doesn't force one,
# or when the requested provider has no server key. Default: gemini (cheapest).
DEFAULT_AI_PROVIDER=gemini

# Per session+IP daily cap on hosted generations. 0 disables the quota.
DAILY_GENERATION_LIMIT=40

# NOTE: These are server-only and never shipped to the browser. Users may still
# enter their own keys in Settings (BYOK), which bypass this endpoint entirely.
